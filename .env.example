# ---- Application ----
DEMO_MODE=true
APP_ENV=development

# ---- Database (SQLite by default; PostgreSQL-ready) ----
DATABASE_URL=sqlite:///./trust_safety.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trust_safety

# ---- Security ----
# NEVER commit a real secret. Generate one: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
RATE_LIMIT_PER_MINUTE=240
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Privacy / DPDP ----
DATA_RETENTION_DAYS=180

# ---- Frontend ----
VITE_API_BASE_URL=http://127.0.0.1:8000
